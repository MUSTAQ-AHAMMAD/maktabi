# Environment Configuration for Maktabi Full Stack
# Copy this file to .env and update with your actual values
# WARNING: Never commit .env to version control

# PostgreSQL Configuration
POSTGRES_DB=maktabi_db
POSTGRES_USER=maktabi
POSTGRES_PASSWORD=maktabi123
POSTGRES_PORT=5432

# Backend Configuration
DATABASE_URL=postgresql://maktabi:maktabi123@postgres:5432/maktabi_db
JWT_SECRET=your-super-secret-jwt-key-change-me-in-production-$(date +%s)
NODE_ENV=development
PORT=9001
FRONTEND_URL=http://localhost:9000
BACKEND_PORT=9001

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:9001
FRONTEND_PORT=9000

# Production Override Examples (uncomment and modify for production):
# NODE_ENV=production
# JWT_SECRET=<generate-with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">
# DATABASE_URL=postgresql://prod_user:prod_password@prod_db_host:5432/prod_db
# FRONTEND_URL=https://yourdomain.com
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com
